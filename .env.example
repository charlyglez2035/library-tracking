TRACKING_HOST=0.0.0.0
TRACKING_PORT=5006
TRACKING_TICK_SECONDS=1
LOGIN_SERVICE_URL=http://127.0.0.1:5000
PEDIDOS_SERVICE_URL=http://127.0.0.1:5004
PAGOS_SERVICE_URL=http://127.0.0.1:5005

# Cuenta del unico administrador. Solo la usa este servidor para aprobar el pago
# simulado y reflejar envio y entrega en pedidos; nunca llega a la app Java.
# Si quedan vacias, los pagos permanecen pending hasta que un admin los apruebe.
SERVICE_ADMIN_IDENTITY=
SERVICE_ADMIN_PASSWORD=

# Duracion de cada etapa de la entrega, en segundos.
SIM_CONFIRMED_SECONDS=6
SIM_PREPARING_SECONDS=8
SIM_SHIPPED_SECONDS=6
SIM_DRIVING_SECONDS=150
